# ─────────────────────────────────────────────────────────────────────────────
# Aepto Content Bot — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit your real .env — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── WordPress ─────────────────────────────────────────────────────────────────
# Base URL of your WordPress site (no trailing slash).
WP_BASE_URL=https://your-site.com

# WordPress username + Application Password.
# Create one at: WP Admin → Users → Profile → Application Passwords
WP_APP_USER=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Sitemap ───────────────────────────────────────────────────────────────────
# Leave blank to fall back to {WP_BASE_URL}/sitemap.xml.
# Many SEO plugins (Yoast, RankMath) use sitemap_index.xml — check yours.
SITEMAP_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where the bot writes its SQLite DB, vector index, review files, etc.
STORAGE_DIR=./storage

# Sentence-Transformers model used for the vector index (embedding). Change
# only if you want a larger/faster model — the default works well out of the box.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Groq — used for article generation and link-insertion drafting.
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — used as the secondary/fallback generation model.
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ── Google Search Console (Part 3 authority scoring) ─────────────────────────
# OAuth client JSON downloaded from Google Cloud Console.
# Setup: Cloud Console → APIs & Services → Credentials → Create Credentials
#        → OAuth client ID → Application type: Desktop app → Download JSON.
# Point this variable at the downloaded file.
GSC_OAUTH_CLIENT_JSON=./gsc-oauth-client.json

# The property URL exactly as it appears in Search Console (trailing slash matters).
GSC_SITE_URL=https://your-site.com/

# How many days back to pull click/impression data for authority scoring.
GSC_LOOKBACK_DAYS=90

# ── Article Generation Tuning ─────────────────────────────────────────────────
# Soft target word count for generated articles.
ARTICLE_TARGET_WORDS=2500

# How many internal links to weave into each generated article.
ARTICLE_INTERNAL_LINKS=4

# ── SEO Plugin ────────────────────────────────────────────────────────────────
# Which SEO plugin is active on the WP site.
# Options: yoast | rankmath | none
# NOTE: Requires wp-snippets/register-seo-meta.php installed as a mu-plugin,
# otherwise meta title/description will silently fail to save (see README).
SEO_PLUGIN=rankmath

# ── Author ────────────────────────────────────────────────────────────────────
# Optional: WordPress user ID to attribute generated posts to.
# Leave blank to use the account that owns the Application Password above.
DEFAULT_AUTHOR_ID=

# Name used in the JSON-LD schema's "author" field.
# Leave blank to fall back to the site's domain (e.g. "your-site.com").
SCHEMA_AUTHOR_NAME=

# ── Internal Linking Tuning (Part 3) ─────────────────────────────────────────
# Max new links inserted into a single existing page per linking run.
MAX_NEW_LINKS_PER_SOURCE_PAGE=2

# Minimum days before the bot will re-edit the same page again.
MIN_DAYS_BETWEEN_EDITS_SAME_PAGE=30

# Number of candidate pages considered per linking run (vector search top-k).
TOP_K_CANDIDATES=8

# Max link insertion proposals generated per new article.
MAX_LINK_PROPOSALS_PER_ARTICLE=4

# ── Image Generation ──────────────────────────────────────────────────────────
# Pexels API key — get one free at https://www.pexels.com/api/
PEXELS_API_KEY=

# Absolute or relative paths to your PNG image templates.
# Featured image template (used as the post's featured_media).
FEATURED_TEMPLATE_PATH=./templates/featured_template.png

# Heading image template (composited and injected before a chosen H2).
HEADING_TEMPLATE_PATH=./templates/heading_template.png
